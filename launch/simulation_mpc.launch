<?xml version="1.0" encoding="utf-8"?>
<launch>
  <!-- Simulation Parameter File -->
  <arg name="ros_param_file" default="$(find uav_mpc)/config/mpc_simulation.yaml"/>
  <arg name="enable_logger" default="true"/>
  <arg name="log_rate" default="20.0"/>

  <!-- Circle Trajectory Parameters -->
  <arg name="center_x" default="0.0"/>
  <arg name="center_y" default="0.0"/>
  <arg name="center_z" default="1.5"/>
  <arg name="radius" default="1.5"/>
  <arg name="linear_vel" default="0.8"/>
  <arg name="start_delay" default="15.0"/>  <!-- 15s to complete auto takeoff & hover stabilization -->
  <arg name="cycles" default="15"/>         <!-- ~175s total flight, fully covering 90~120s wind gust -->

  <rosparam command="load" file="$(arg ros_param_file)"/>

  <!-- 1. Start MPC Controller Node -->
  <node pkg="uav_mpc" type="mpc_node" name="mpc_node" output="screen">
  </node>

  <!-- 2. Start Data Logger Node (NMPC Tagged) -->
  <group if="$(arg enable_logger)">
    <node pkg="uav_mpc" type="data_logger_node" name="data_logger_node" output="screen">
      <param name="log_prefix" value="NMPC"/>
      <param name="log_rate" value="$(arg log_rate)"/>
    </node>
  </group>

  <!-- 3. Start Circle Trajectory Publisher Node -->
  <node pkg="uav_mpc" type="circle_traj_node" name="circle_traj_node" output="screen">
    <param name="center_x" value="$(arg center_x)"/>
    <param name="center_y" value="$(arg center_y)"/>
    <param name="center_z" value="$(arg center_z)"/>
    <param name="radius" value="$(arg radius)"/>
    <param name="linear_vel" value="$(arg linear_vel)"/>
    <param name="start_delay" value="$(arg start_delay)"/>
    <param name="cycles" value="$(arg cycles)"/>
    <param name="publish_rate" value="50.0"/>
  </node>
</launch>
